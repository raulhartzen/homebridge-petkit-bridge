{
  "name": "homebridge-petkit-bridge",
  "displayName": "PetKit Bridge",
  "version": "0.6.1",
  "description": "Homebridge plugin for petkit-bridge: exposes PetKit feeders, litter boxes and fountains to Apple HomeKit via the local petkit-bridge HTTP API.",
  "license": "MIT",
  "author": "raulhartzen",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/raulhartzen/homebridge-petkit-bridge.git"
  },
  "bugs": {
    "url": "https://github.com/raulhartzen/homebridge-petkit-bridge/issues"
  },
  "homepage": "https://github.com/raulhartzen/homebridge-petkit-bridge#readme",
  "keywords": [
    "homebridge-plugin",
    "supports-hap",
    "petkit",
    "homekit",
    "feeder",
    "litter-box",
    "fountain"
  ],
  "main": "dist/index.js",
  "files": [
    "dist",
    "config.schema.json"
  ],
  "engines": {
    "node": ">=18.0.0",
    "homebridge": ">=1.6.0"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "homebridge": "^1.8.0",
    "typescript": "^5.4.0"
  }
}